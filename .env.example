GEMINI_API_KEY=tu_api_key_de_gemini_aqui
GEMINI_MODEL=gemini-3.5-flash-lite

# Dirección de la mock API desde el backend dentro de la red de Docker.
# Si cambias el puerto interno 4000, actualiza el puerto aquí y en docker-compose.yml.
MOCK_API_URL=http://mock-api:4000/
# Puerto publicado en el host para consultar la mock API directamente.
MOCK_API_PORT=4000

# Puertos publicados en el host.
BACKEND_PORT=5000
FRONTEND_PORT=5173
